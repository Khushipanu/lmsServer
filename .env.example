# ---------------------------------------------------------------
# Copy to .env for local dev. On Render, add these in the dashboard
# (Render does NOT read this file). After deploy, open
#   https://<your-api>.onrender.com/health
# to see which services are configured.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas -> Network Access must allow 0.0.0.0/0 for Render to connect.
MONGODB_URI=mongodb://localhost:27017/lms

# Long random strings (Render can generate these)
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACTIVATION_SECRET=change_me_to_a_long_random_string
FORGOT_SECRET_KEY=change_me_to_a_long_random_string

# Frontend URL(s), comma-separated, NO trailing slash.
# Used for CORS, the Google login redirect and links in emails.
CLIENT_URL=http://localhost:5173

# ---------------- Email (pick ONE) ----------------
# Render's free plan blocks SMTP, so use an HTTPS provider there.
# Brevo: brevo.com -> SMTP & API -> API Keys. EMAIL_FROM must be a sender
# verified in Brevo (Senders & IP). A domain you own delivers far better than
# a @gmail.com sender, which Gmail often sends to spam.
BREVO_API_KEY=
EMAIL_FROM=you@example.com
# Resend alternative (needs a verified domain to email anyone but yourself):
# RESEND_API_KEY=
# SMTP alternative (local / paid hosting only). Gmail needs an App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# Force a provider instead of auto-detect: brevo | resend | smtp
# EMAIL_PROVIDER=
# Emergency only: show the signup code on screen if email fails.
# EMAIL_OTP_FALLBACK=false

# ---------------- Google OAuth ----------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI must EXACTLY equal GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ---------------- Payments (Razorpay) ----------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------- File uploads (Cloudinary) ----------------
# Strongly recommended on Render: its disk is wiped on every deploy/restart,
# so locally stored course images and videos disappear.
# cloudinary.com -> Dashboard -> "API environment variable"
CLOUDINARY_URL=
# MAX_UPLOAD_MB=200

# ---------------- AI tutor ----------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
